# ---------------------------------------------------------------------------
# Liquid Glass Crypto Lab - environment template
# Copy to .env for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_NAME=Liquid Glass Crypto Lab
VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# SQLite locally. In production use Neon: `neon deploy` writes both URLs into
# .env.local (pooled for the app, direct for Alembic). Plain postgres:// and
# postgresql:// strings are rewritten for asyncpg automatically.
# DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./data/crypto_lab.db
DATABASE_URL_UNPOOLED=

# Comma separated origins, or * for development
CORS_ORIGINS=*

# Scanner
SCANNER_ENABLED=true
SCAN_INTERVAL_SECONDS=60
DISCOVERY_WINDOW_HOURS=6
MIN_TICK_GAP_SECONDS=45
# Protect POST /api/v1/scanner/tick. Leave empty to accept ticks from loopback only.
SCANNER_TICK_TOKEN=
# Optional. If set, mutating endpoints require the X-Admin-Token header.
ADMIN_TOKEN=

# Paper account and risk rules (hard limits)
INITIAL_BALANCE_USD=10
MAX_OPEN_POSITIONS=3
MAX_POSITION_USD=2.5
DAILY_LOSS_LIMIT_USD=0.5
MAX_PRICE_IMPACT_PCT=1.0
MAX_PRICE_AGE_SECONDS=120

# Execution estimates
SOL_PRICE_USD=150
BNB_PRICE_USD=600
SOLANA_NETWORK_FEE_USD=0.003
BSC_NETWORK_FEE_USD=0.03
DEX_FEE_PCT=0.25
BASE_SLIPPAGE_BPS=50

# Providers
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
GT_RATE_LIMIT_PER_MIN=25
DS_RATE_LIMIT_PER_MIN=50
GOPLUS_RATE_LIMIT_PER_MIN=20
RUGCHECK_RATE_LIMIT_PER_MIN=12

# Discord (webhook is enough; bot token optional and only used if channel id set)
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ENABLED=true

# Data retention (keeps free database small)
SNAPSHOT_FULL_DAYS=7
SNAPSHOT_RAW_HOURS=24

# Optional tuning
SCANNER_CANDIDATES_PER_TICK=10
SCANNER_SECURITY_REFRESH_PER_TICK=5
SCANNER_TICK_TIMEOUT_SECONDS=240
GT_DISCOVERY_PAGES=1
DS_BATCH_SIZE=25
MAX_DS_BATCHES_PER_TICK=2
